    },
    {
      "name": "gdk-pixbuf",
      "features": [ "others" ]
    },
    "gtk2",
    "gtk3",
    "tilibs"
  ],
  "builtin-baseline": "a993be073c6baea8674117f3eaed6e2d2486aaae"
}
