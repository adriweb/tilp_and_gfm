{
  "name": "tilp-and-gfm",
  "version-string": "1.19",
  "homepage": "https://github.com/debrouxl/tilp_and_gfm",
  "description": "TILP (formerly GtkTiLink) can transfer data between TI graphing calculators and a computer",
  "dependencies": [
