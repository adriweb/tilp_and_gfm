{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 1
  },
  "configurePresets": [
    {
      "name": "ninja-vcpkg",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "binaryDir": "${sourceDir}/tilp.build/${presetName}",
      "installDir": "${sourceDir}/tilp.build/${presetName}",
      "cacheVariables": {
        "VCPKG_MANIFEST_MODE": {
          "type": "BOOL",
          "value": "True"
        },
        "VCPKG_MANIFEST_INSTALL": {
          "type": "BOOL",
          "value": "True"
        },
        "VCPKG_OVERLAY_PORTS": {
          "type": "STRING",
          "value": "${sourceDir}/.cmake/vcpkg_overlay_ports"
        },
        "VCPKG_OVERLAY_TRIPLETS": {
          "type": "STRING",
          "value": "${sourceDir}/.cmake/vcpkg_overlay_triplets"
        },
        "VCPKG_INSTALL_OPTIONS": {
          "type": "STRING",
          "value": "--allow-unsupported"
        }
      }
    },
    {
      "name": "ninja-vcpkg-x64",
      "hidden": true,
      "inherits": "ninja-vcpkg",
      "architecture": {
        "strategy": "external",
        "value": "x64"
      }
    },
    {
      "name": "ninja-vcpkg-x86",
      "hidden": true,
      "inherits": "ninja-vcpkg",
      "architecture": {
        "strategy": "external",
        "value": "x86"
      }
    },
    {
      "name": "ninja-vcpkg-arm64",
      "hidden": true,
      "inherits": "ninja-vcpkg",
      "architecture": {
        "strategy": "external",
        "value": "arm64"
      }
    },
    {
      "name": "GTK2",
      "hidden": true,
      "cacheVariables": {
        "USE_GTK2": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "win-only",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "mac-only",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-only",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "Win-x64-GTK3",
      "inherits": [ "ninja-vcpkg-x64", "win-only" ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": {
          "type": "STRING",
          "value": "x64-windows-static"
        },
        "BUILD_SHARED_LIBS": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "Win-x86-GTK3",
      "inherits": [ "ninja-vcpkg-x86", "win-only" ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": {
          "type": "STRING",
          "value": "x86-windows-static"
        },
        "BUILD_SHARED_LIBS": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "Mac-x64-GTK3",
      "inherits": [ "ninja-vcpkg-x64", "mac-only" ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": {
          "type": "STRING",
          "value": "x64-osx"
        },
        "BUILD_SHARED_LIBS": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "Mac-arm64-GTK3",
      "inherits": [ "ninja-vcpkg-arm64", "mac-only" ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": {
          "type": "STRING",
          "value": "arm64-osx"
        },
        "BUILD_SHARED_LIBS": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "Linux-x64-GTK3",
      "inherits": [ "ninja-vcpkg-x64", "linux-only" ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": {
          "type": "STRING",
          "value": "x64-linux"
        },
        "BUILD_SHARED_LIBS": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "Linux-x64-GTK3-Dynamic",
      "inherits": [ "ninja-vcpkg-x64", "linux-only" ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": {
          "type": "STRING",
          "value": "x64-linux-dynamic-apng"
        },
        "BUILD_SHARED_LIBS": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "Linux-x64-GTK2",
      "inherits": [ "Linux-x64-GTK3", "GTK2" ]
    },
    {
      "name": "Linux-x64-GTK2-Dynamic",
      "inherits": [ "Linux-x64-GTK3", "GTK2" ]
    },
    {
      "name": "Win-x64-GTK2",
      "inherits": [ "Win-x64-GTK3", "GTK2" ]
    },
    {
      "name": "Win-x86-GTK2",
      "inherits": [ "Win-x86-GTK3", "GTK2" ]
    },
    {
      "name": "Mac-x64-GTK2",
      "inherits": [ "Mac-x64-GTK3", "GTK2" ]
    },
    {
      "name": "Mac-arm64-GTK2",
      "inherits": [ "Mac-arm64-GTK3", "GTK2" ]
    }
  ],
